# Copia questo file in .env e completa i valori. Il file .env non va mai committato.

# Ambiente: "production" attiva cookie solo HTTPS e rende obbligatoria SESSION_SECRET.
NODE_ENV=development

# Chiave segreta per firmare i cookie di sessione (almeno 32 caratteri casuali).
# Per generarne una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Account demo amministratore (admin@example.com, password pubblica): "true" o "false".
# Se non impostata vale true in sviluppo e false in produzione, dove l'admin demo non può accedere
# e non viene creato su un database nuovo. Il vero amministratore si crea con admin:promote (vedi README).
# DEMO_ADMIN_ENABLED=

# Porta del server API (il frontend in sviluppo usa la 5173).
API_PORT=3001

# Percorso del database SQLite (facoltativo).
# DB_PATH=server/data/discoverevent.db

# Come si presenta il server al servizio di ricerca città (Nominatim di OpenStreetMap), facoltativo.
# Le regole d'uso chiedono di identificare l'app: prima del deploy aggiungi un contatto,
# es. DiscoverEvent/1.0 (indirizzo@example.com)
# GEOCODER_USER_AGENT=DiscoverEvent/0.3 (progetto didattico)

# Chiave della Ticketmaster Discovery API (facoltativa): serve solo allo spike
# "npm run spike:ticketmaster -w @discoverevent/api". Si ottiene gratis su developer.ticketmaster.com.
TICKETMASTER_API_KEY=
