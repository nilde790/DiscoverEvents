# Valori fissi per "npm run dev", caricati con --env-file (nessun segreto: questo file si committa).
# Le variabili già impostate nella shell hanno la precedenza su questo file.

# Alcuni strumenti di anteprima impostano PORT=5173 per il frontend: senza API_PORT le API userebbero
# quella porta e il proxy di Vite (che le cerca sulla 3001) non le troverebbe.
API_PORT=3001
