{
  "name": "@discoverevent/api",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "spike:ticketmaster": "tsx scripts/spike-ticketmaster.ts",
    "db:reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@discoverevent/shared": "*",
    "bcryptjs": "3.0.2",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "express-session": "1.19.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.1",
    "@types/node": "24.0.3",
    "tsx": "4.23.15"
  }
}
