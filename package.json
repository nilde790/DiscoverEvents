{
  "name": "discover-event",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "tsx --test server/*.test.ts",
    "check": "npm run typecheck && npm test",
    "db:reset": "node -e \"require('fs').rmSync('server/data',{recursive:true,force:true})\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "express": "4.21.1",
    "express-rate-limit": "7.5.0",
    "express-session": "1.18.1",
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "6.28.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.1",
    "@types/leaflet": "1.9.12",
    "@types/node": "24.0.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "9.1.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
