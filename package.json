{
  "name": "discover-event",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @discoverevent/api",
    "dev:web": "npm run dev -w @discoverevent/web",
    "build": "npm run build -w @discoverevent/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "db:reset": "npm run db:reset -w @discoverevent/api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.0.3",
    "concurrently": "9.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2"
  }
}
